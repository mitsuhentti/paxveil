# Never commit .env. Generate random database password and bot key (scripts/init.ps1).
DATABASE_URL=postgresql+psycopg://paxveil:CHANGE_ME@127.0.0.1:55432/paxveil
POSTGRES_PASSWORD=CHANGE_ME
PAXVEIL_BOT_KEY=GENERATE_RANDOM_64_HEX_CHARACTERS
TELEGRAM_BOT_TOKEN=
PAXVEIL_API_URL=http://127.0.0.1:8000
PAXVEIL_WEB_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECURE_COOKIES=false
REGISTRATION_ENABLED=true
WATCH_INTERVAL_SECONDS=21600
MAX_FILE_BYTES=1048576
PAXVEIL_CACHE_DIR=./runtime/cache
