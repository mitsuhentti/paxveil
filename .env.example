# Never commit .env. Generate random database password and bot key (scripts/init.ps1).
DATABASE_URL=postgresql+psycopg://paxveil:CHANGE_ME@127.0.0.1:55432/paxveil
POSTGRES_PASSWORD=CHANGE_ME
PAXVEIL_BOT_KEY=GENERATE_RANDOM_64_HEX_CHARACTERS
TELEGRAM_BOT_TOKEN=
PAXVEIL_API_URL=http://127.0.0.1:8000
PAXVEIL_WEB_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECURE_COOKIES=false
REGISTRATION_ENABLED=true
WATCH_INTERVAL_SECONDS=21600
MAX_FILE_BYTES=1048576
MAX_PROJECTS_PER_USER=10
MAX_ACTIVE_JOBS_PER_USER=3
MAX_ANALYSIS_JOBS_PER_HOUR=10
MAX_OWNER_STORAGE_BYTES=67108864
MAX_REPORT_BYTES=8388608
MAX_SESSIONS_PER_USER=20
RETAINED_SCANS_PER_PROJECT=30
RETAINED_STATUS_CHANGES_PER_PROJECT=1000
TERMINAL_JOB_RETENTION_DAYS=30
NOTIFICATION_RETENTION_DAYS=90
PAXVEIL_CACHE_DIR=./runtime/cache
PAXVEIL_CACHE_MAX_BYTES=268435456
PAXVEIL_CACHE_MAX_KEYS=10000
